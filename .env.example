# Copy to .env and adjust. Used by docker-compose.yml. .env is git-ignored.

# Run both containers as your host user so bind-mounted files (state/,
# workspace/, agents/, and the repo /repo) stay owned by you instead of root.
# Find yours with:  id -u ; id -g
KAMI_UID=1000
KAMI_GID=1000

# --- code-service (self-editing / PR container) -----------------------------
# Claude Code CLI auth. A subscription login can't be reached inside a
# container, so provide an Anthropic API key for the code-service backend.
ANTHROPIC_API_KEY=

# GitHub auth so kami can push branches and open PRs against its own repo.
# A fine-grained or classic PAT with repo (contents + pull_requests) scope.
GH_TOKEN=

# Commit identity for kami's self-PRs.
GIT_AUTHOR_NAME=kami-bot
GIT_AUTHOR_EMAIL=kami-bot@users.noreply.github.com

# Optional: timezone for cron schedules (see cron.go). Defaults to UTC.
# TZ=Europe/London
